{
  "manifest_version": 3,
  "name": "Draft Queue for X",
  "short_name": "Draft Queue",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "Local draft queue that opens X's composer for you to schedule or post. Does not post, schedule, or call the X API.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Draft Queue",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/compose.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
